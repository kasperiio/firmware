#!/bin/sh

set_gpio()
{
    if [ ! -d "/sys/class/gpio/GPIO$1" ]; then
        echo $1 > /sys/class/gpio/export
        echo out > /sys/class/gpio/GPIO$1/direction
    fi

    echo $2 > /sys/class/gpio/GPIO$1/value
}

# Modules load with modprobe (dep-resolved from modules.dep) in the vendor's
# explicit order; each dep is already up by the time a later module names it,
# so modprobe never re-pulls rtvbus without its firmware parameters.
# Memory layout depends on the chip: FH8852 boards carry 64 MiB of DDR,
# FH8856 boards 128 MiB (Linux gets mem=32M; the rest is video memory).
CHIP=$(sed -n 's/^chip_name[[:space:]]*:[[:space:]]*//p' /proc/driver/chip 2>/dev/null)
case "$CHIP" in
	FH8856*)
		modprobe vmm mmz=anonymous,0,0xA2000000,64M anony=1
		set_gpio 13 0
		modprobe rtvbus ra=0xa7e00000 rs=65536 fn=rtthread_arc_FH8856.bin fa=0xa7f00000
		;;
	*)
		modprobe vmm mmz=anonymous,0,0xA1D00000,33M anony=1
		set_gpio 13 0
		modprobe rtvbus ra=0xa3e00000 rs=65536 fn=rtthread_arc_FH8852.bin fa=0xa3f00000
		;;
esac

#reset sensor
set_gpio 13 1

modprobe media_process
modprobe isp
modprobe vpu vpu_mode=buf_0_3,buf_1_4
modprobe enc
modprobe hevc
modprobe jpeg
modprobe bgm
modprobe vbus_ac
