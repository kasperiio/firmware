#!/bin/sh
#
# Start the divinus streamer (used on SoCs without a majestic build)
#

DAEMON=/usr/bin/divinus
[ -x $DAEMON ] || exit 0
[ -f /etc/divinus.yaml ] || exit 0

case "$1" in
	start)
		echo "Starting divinus..."
		start-stop-daemon -S -b -m -p /var/run/divinus.pid -x /bin/sh -- -c "LD_LIBRARY_PATH=/usr/lib exec $DAEMON >/tmp/divinus.log 2>&1"
		;;
	stop)
		echo "Stopping divinus..."
		start-stop-daemon -K -x $DAEMON
		for i in $(seq 1 20); do pidof divinus >/dev/null || break; sleep 1; done
		;;
	restart)
		$0 stop
		sleep 1
		$0 start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
