+    {0x0243,0x06}, {0x02ce,0xbf}, {0x02ee,0x30}, {0x026f,0x70}, {0x0257,0x09}, {0x0211,0x02},
+    {0x0219,0x09}, {0x023f,0x2d}, {0x0518,0x00}, {0x0519,0x01}, {0x0515,0x08}, {0x02d9,0x3f},
+    {0x02da,0x02}, {0x02db,0xe8}, {0x02e6,0x20}, {0x021b,0x10}, {0x0252,0x22}, {0x024e,0x22},
+    {0x02c4,0x01}, {0x021d,0x07}, {0x024a,0x01}, {0x02ca,0x02}, {0x0262,0x10}, {0x029a,0x20},
+    {0x021c,0x0e}, {0x0298,0x03}, {0x029c,0x00}, {0x027e,0x14}, {0x02c2,0x10}, {0x0540,0x20},
